    <term_definitions code="at0000">
      <items id="text">Ferro validation grid</items>
      <items id="description">A synthetic observation invented for the validation tests.</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="text">History</items>
      <items id="description">The event history.</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="text">Any event</items>
      <items id="description">A point in time.</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="text">Tree</items>
      <items id="description">The item tree.</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="text">Pressure</items>
      <items id="description">A quantity the template bounds to 0 to 300 mm[Hg].</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="text">Position</items>
      <items id="description">A coded text the template enumerates two codes for.</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="text">Sitting</items>
      <items id="description">Seated.</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="text">Standing</items>
      <items id="description">Upright.</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="text">Reference</items>
      <items id="description">A text the template constrains to a pattern.</items>
    </term_definitions>
    <term_definitions code="at0015">
      <items id="text">Required note</items>
      <items id="description">A node the template makes mandatory.</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="text">Single note</items>
      <items id="description">A node the template admits at most once.</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="text">Tally</items>
      <items id="description">A count the template bounds to 1 to 5.</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="text">Bundle</items>
      <items id="description">A cluster whose items are bounded to one or two.</items>
    </term_definitions>
    <term_definitions code="at0021">
      <items id="text">Bundle member</items>
      <items id="description">A member of the bundle.</items>
    </term_definitions>
