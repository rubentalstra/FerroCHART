    <term_definitions code="at0000">
      <items id="text">Ferro tied alternatives</items>
      <items id="description">A synthetic template invented for this test.</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="text">History</items>
      <items id="description">The event history.</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="text">Any event</items>
      <items id="description">One point event.</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="text">Tree</items>
      <items id="description">The item tree of the event.</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="text">A reading</items>
      <items id="description">The one element the event carries.</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="text">Protocol</items>
      <items id="description">The protocol tree, stated twice with different content.</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="text">Told apart by content</items>
      <items id="description">The element the two alternatives constrain differently.</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="text">Only in the first</items>
      <items id="description">An element only the first alternative carries.</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="text">Also only in the first</items>
      <items id="description">A second element only the first alternative carries.</items>
    </term_definitions>
  </definition>
