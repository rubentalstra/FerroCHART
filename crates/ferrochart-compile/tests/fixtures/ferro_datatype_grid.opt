    <term_definitions code="at0000">
      <items id="text">Ferro data type grid</items>
      <items id="description">A synthetic template invented for the field derivation tests.</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="text">Tree</items>
      <items id="description">The item tree.</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="text">Confirmed</items>
      <items id="description">A boolean the template has already decided.</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="text">Present</items>
      <items id="description">A boolean the clinician decides.</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="text">Episodes</items>
      <items id="description">A synthetic count.</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="text">Onset date</items>
      <items id="description">A synthetic partial date.</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="text">Onset time</items>
      <items id="description">A synthetic partial time.</items>
    </term_definitions>
    <term_definitions code="at0015">
      <items id="text">Recorded</items>
      <items id="description">A synthetic date and time.</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="text">Elapsed</items>
      <items id="description">A synthetic duration.</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="text">Record number</items>
      <items id="description">A synthetic identifier.</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="text">Attachment</items>
      <items id="description">A synthetic attachment.</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="text">Instructions</items>
      <items id="description">A synthetic parsable text.</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="text">Reference</items>
      <items id="description">A synthetic reference.</items>
    </term_definitions>
    <term_definitions code="at0021">
      <items id="text">Record link</items>
      <items id="description">A synthetic link into an EHR.</items>
    </term_definitions>
    <term_definitions code="at0022">
      <items id="text">Range of episodes</items>
      <items id="description">A synthetic interval of counts.</items>
    </term_definitions>
    <term_definitions code="at0023">
      <items id="text">Finding</items>
      <items id="description">A synthetic finding, coded or free text.</items>
    </term_definitions>
    <term_definitions code="at0024">
      <items id="text">Anything</items>
      <items id="description">A value the template never constrained.</items>
    </term_definitions>
    <term_definitions code="at0025">
      <items id="text">Note</items>
      <items id="description">A synthetic repeatable note.</items>
    </term_definitions>
    <term_definitions code="at0026">
      <items id="text">Summary</items>
      <items id="description">A synthetic mandatory summary.</items>
    </term_definitions>
    <term_definitions code="at0027">
      <items id="text">Named note</items>
      <items id="description">A note whose name the template leaves open.</items>
    </term_definitions>
    <term_definitions code="at0028">
      <items id="text">Share</items>
      <items id="description">A synthetic percentage.</items>
    </term_definitions>
    <term_definitions code="at0029">
      <items id="text">Unbounded</items>
      <items id="description">An interval whose element type the template never states.</items>
    </term_definitions>
    <term_definitions code="at0030">
      <items id="text">Positive</items>
      <items id="description">A synthetic positive finding.</items>
    </term_definitions>
    <term_definitions code="at0031">
      <items id="text">Negative</items>
      <items id="description">A synthetic negative finding.</items>
    </term_definitions>
    <term_definitions code="at0032">
      <items id="text">First note</items>
      <items id="description">One name the template admits.</items>
    </term_definitions>
    <term_definitions code="at0033">
      <items id="text">Second note</items>
      <items id="description">The other name the template admits.</items>
    </term_definitions>
    <term_definitions code="at0034">
      <items id="text">Pressure</items>
      <items id="description">A synthetic pressure in two units.</items>
    </term_definitions>
  </definition>
</template>
