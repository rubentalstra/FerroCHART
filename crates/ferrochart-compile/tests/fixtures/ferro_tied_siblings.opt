    <term_definitions code="at0000">
      <items id="text">Ferro tied siblings</items>
      <items id="description">A synthetic template invented for this test.</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="text">Twice over</items>
      <items id="description">An element the template states twice, identically.</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="text">One value stated twice</items>
      <items id="description">An element whose value states one alternative twice.</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="text">A group stated twice</items>
      <items id="description">A cluster the template states twice, identically.</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="text">Inside the group</items>
      <items id="description">The element inside the twice-stated cluster.</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="text">A capped container</items>
      <items id="description">A cluster whose own container holds at most one member.</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="text">Capped twice over</items>
      <items id="description">An element stated twice inside a container that holds one.</items>
    </term_definitions>
  </definition>
