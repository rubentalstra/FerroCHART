-- SPDX-License-Identifier: BUSL-1.1
-- Synthetic content invented for this test. No patient data.
--
-- A quantity whose magnitude is stated as an enumeration rather than an
-- interval. openEHR AM Release-2.3.0 AOM2.html section 8.4.3 gives C_REAL
-- both a list and a range, so the shape is legal; one permitted unit carries
-- one magnitude interval (RM Release-1.1.0 data_types.html section 6.2.8), so
-- the derivation refuses it rather than reading part of it.
archetype (adl_version=2.0.5; rm_release=1.0.2)
    openEHR-EHR-OBSERVATION.ferro_adl2_unit_bounds.v1.0.0

language
    original_language = <[ISO_639-1::en]>

description
    lifecycle_state = <"published">

definition
    OBSERVATION[id1] occurrences matches {1..1} matches {
        data matches {
            ITEM_TREE[id2] occurrences matches {1..1} matches {
                items existence matches {0..1} cardinality matches {0..*; ordered} matches {
                    ELEMENT[id3] occurrences matches {0..1} matches {
                        value matches {
                            DV_QUANTITY[id4] occurrences matches {1..1} matches {
                                magnitude matches {1.0, 2.5, 5.0}
                                units matches {"mL"}
                            }
                        }
                    }
                }
            }
        }
    }

terminology
    term_definitions = <
        ["en"] = <
            ["id1"] = < text = <"Ferro ADL 2 unit bounds"> description = <"A synthetic observation invented for this test."> >
            ["id2"] = < text = <"Tree"> description = <"The item tree."> >
            ["id3"] = < text = <"Dose"> description = <"A synthetic dose."> >
            ["id4"] = < text = <"Dose amount"> description = <"An amount stated as one of three magnitudes."> >
        >
    >
