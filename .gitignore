# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Claude Code personal/local overrides (never committed)
.claude/settings.local.json

# Claude Code agent worktrees (isolated per-agent checkouts, never committed)
.claude/worktrees/

# The rendered book (the mdBook build-dir) and the assembled site, once the
# documentation lane lands.
/website/book/book/
/_site/

# The CKM exports that state no licence are fetched, never committed
# (corpus/templates/ckm/PROVENANCE.md).
corpus/templates/ckm/unstated/

# The rendered book
website/book/book/

# The ADL 2 archetype pack states no licence, so it is fetched and never
# committed (corpus/archetypes/adl2/PROVENANCE.md).
corpus/archetypes/adl2/**/*.adls
corpus/archetypes/adl2/**/*.adl
corpus/archetypes/adl2/_repo_lib.idx
corpus/archetypes/adl2/readme.txt

# Staged from assets/brand/ by scripts/site/assemble.sh, never committed.
website/book/theme/
